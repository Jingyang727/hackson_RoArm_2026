# Copy to ~/.evoarm/company_llm.env, preserving a backup of the previous profile.
# Replace the empty key ON YOUR MACHINE. Never commit the completed file.
EVOARM_COMPANY_LLM_BASE_URL=https://inference-bottlerocket.tesla.cn/v1
EVOARM_COMPANY_LLM_MODEL=DeepSeek-V4.1-Flash
BRCN_9901_API_KEY=
EVOARM_COMPANY_LLM_ENABLE_THINKING=0
EVOARM_COMPANY_LLM_TEMPERATURE=0.2
# Optional: use 0 only if the gateway requires buffered responses.
EVOARM_COMPANY_LLM_STREAM=1
